    "client": ["de.invseesummary.InvSeeSummaryClient"]
  },
  "mixins": ["invseesummary.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "${mc}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
